---
import CinematicBackground from '@/components/CinematicBackground.astro'
import Navbar from '@/components/Navbar.astro'
import { allLocales, base } from '@/config'
import { getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'
import { getPageInfo } from '@/utils/page'
import '@/styles/memoir.css'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const { getLocalizedPath } = getPageInfo(Astro.url.pathname)

interface Memory {
  date: string
  city: string
  image: string
  width: number
  height: number
  alt: string
  caption: string
  detail: string
  copyOffsetRatio?: number
}

const memories: Memory[] = [
  {
    date: '2025.01',
    city: 'Matterhorn, Switzerland',
    image: `${base}/images/memoir/matterhorn-2025.webp`,
    width: 6048,
    height: 4024,
    alt: '一群同事在马特洪峰雪山岩石上合影',
    caption: '马特洪峰：外派的尾声',
    detail: '这张合照现在看来，仿佛浓缩定格了我三年欧洲外派时光，是我那三年心境和自我认知的最真实的映射：放松、自信、成长，是属于我那三年的真正的人生照片。',
  },
  {
    date: '2024.10',
    city: 'Paris, France',
    image: `${base}/images/memoir/paris-bag-2024.webp`,
    width: 3024,
    height: 4032,
    alt: '巴黎店内一位女士笑着举起刚买到的新包',
    caption: '买到新包的喜悦溢于言表',
    detail: '每年这个时候我都会来巴黎参加行业展会，媳妇儿都会来看看自己心仪的包包，这次来成功拿下一个新包，开心完了，有多开心看图就能知道',
  },
  {
    date: '2023.01',
    city: 'Warsaw, Poland',
    image: `${base}/images/memoir/warsaw-2023.webp`,
    width: 3024,
    height: 4032,
    alt: '华沙夜晚路灯下被风吹动的漫天大雪',
    caption: '瓢泼大雪',
    detail: '外派第一年冬天，华沙下了很多场雪，但气温其实没有很低，比西安稍冷。晚上下班回家，遇上大雪天，地上的积雪被风一吹，就像白色的沙子一样在流动。华沙的主路永远看不到积雪，因为下雪的当天/夜就被全部清理掉了。',
  },
  {
    date: '2022.12',
    city: 'Warsaw, Poland',
    image: `${base}/images/memoir/warsaw-new-year-2022.webp`,
    width: 4032,
    height: 3024,
    alt: '华沙老城广场跨年前夕的人群、圣诞树与夜景',
    caption: '外派后的第一次跨年',
    detail: '来到欧洲后的第一次跨年夜，和地区部同事一起到老城广场看0点的跨年烟花。差不多23点开始人流就陆陆续续的在老城扎堆儿了，说实话可能大半个华沙的人都来了。烟花其实一般（尤其是后来对比了伦敦的跨年烟花），但氛围很棒，倒计时和欢呼，还有啤酒...结束散场之后我们挤上蔡书记的单排座A5回家，凌晨1点的Obrzezna很安静，几乎没有行人，但不会让人觉得需要警惕或者提心吊胆，甚至有跨年蹦迪的声音从小区楼里传出来给我助助兴。',
  },
  {
    date: '2022.12',
    city: 'Chisinau, Moldova',
    image: `${base}/images/memoir/chisinau-2022.webp`,
    width: 3024,
    height: 4032,
    alt: '基希讷乌夜色下悬挂摩尔多瓦国旗的拱门与街道行人',
    caption: '外派后的第一次出差',
    detail: '第一次出差：东欧小国摩尔多瓦，第一次出差，见识了堪比小时候青镇基建水平的国家首都...',
  },
  {
    date: '2022.11',
    city: 'Krakow, Poland',
    image: `${base}/images/memoir/krakow-2022.webp`,
    width: 1252,
    height: 1670,
    alt: '克拉科夫街头的红砖哥特式建筑与骑车人',
    caption: '外派后的第一次出游',
    detail: '波兰国庆节我和老胡、刚烈一起去了克拉科夫两日游，去了大名鼎鼎的盐矿，原本还要去辛德勒的工厂，但那天不营业就没有去成了。晚餐吃了牛排，金刚同学推荐的，相当之美味，牛排和前菜的煎鱿鱼都非常好吃，以至于外派3年吃过N家牛排后，克拉科夫的那一家仍然是我心中牛排的No.1。',
  },
  {
    date: '2022.11',
    city: 'Warsaw, Poland',
    image: `${base}/images/memoir/warsaw-first-weekend-2022.webp`,
    width: 2400,
    height: 1800,
    alt: '华沙秋日公园里阳光穿过树林与满地落叶',
    caption: '外派后的第一个周末',
    detail: '外派后的第一个周末，在地图上搜了一个附近的公园去逛逛，很干净也很安静，让人放松，阳光很好，天气凉凉的，是我最喜欢的那种，就是手机信号不太，微信视频电话画面非常糊通话也非常卡，但透过糊成渣的画面，媳妇儿还是看出了华沙的干净平静，还有很多美女，哈哈。',
  },
  {
    date: '2022.10',
    city: 'Warsaw, Poland',
    image: `${base}/images/memoir/warsaw-arrival-2022.webp`,
    width: 3024,
    height: 4032,
    alt: '华沙办公园区内华为与育碧标志同框的街景',
    caption: '外派落地',
    detail: '到华沙是周日接近中午的时候，约了中国人的出租车一路到了提前订好的公寓，之后去了办公楼下，看到公司居然和UBISOFT在同一栋楼里，还挺新鲜。',
  },
]

function getCopyOffsetRatio(memory: Memory) {
  return memory.copyOffsetRatio ?? (memory.width > memory.height ? 1 / 5 : undefined)
}
---

<Layout
  postTitle="欧洲外派手记"
  postDescription="把外派3年的回忆做成相册"
  immersive
>
  <article id="memoir-top" class="memoir-page" aria-labelledby="memoir-title">
    <div class="memoir-hero-scene" aria-hidden="true">
      <CinematicBackground />
    </div>

    <div class="memoir-shell">
      <header class="wandor-hero-header memoir-header">
        <a class="wandor-wordmark" href={getLocalizedPath('/')} aria-label="yichu 首页">yichu</a>
        <div class="wandor-nav-shell memoir-nav-shell">
          <Navbar variant="overlay" />
        </div>
      </header>

      <main class="memoir-main">
        <header class="memoir-intro">
          <p class="memoir-kicker">EUROPE · AN EXPAT MEMOIR</p>
          <h1 id="memoir-title">欧洲外派手记</h1>
          <p>把外派3年的回忆做成相册</p>
          <span class="memoir-intro-rule" aria-hidden="true"></span>
        </header>

        <ol class="memoir-timeline" aria-label="欧洲外派时间轴">
          {memories.map((memory, index) => (
            <li
              class:list={['memoir-memory', index % 2 === 0 ? 'memoir-memory--right' : 'memoir-memory--left']}
              data-memory
              data-copy-offset-ratio={getCopyOffsetRatio(memory)}
            >
              <figure
                class="memoir-photo-wrap"
                data-reveal
                style={`--memoir-photo-ratio: ${memory.width} / ${memory.height};`}
              >
                <img
                  src={memory.image}
                  alt={memory.alt}
                  width={memory.width}
                  height={memory.height}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : 'auto'}
                  decoding="async"
                />
              </figure>

              <span class="memoir-node" aria-hidden="true"></span>

              <div class="memoir-copy" data-reveal>
                <p class="memoir-meta">
                  <time>{memory.date}</time>
                  <span aria-hidden="true">·</span>
                  <strong>{memory.city}</strong>
                </p>
                <h2>{memory.caption}</h2>
                <p class="memoir-detail">{memory.detail}</p>
              </div>
            </li>
          ))}
        </ol>

        <footer class="memoir-footer">
          <a class="memoir-back-to-top" href="#memoir-top" aria-label="回到页面顶部">
            <i class="ph ph-arrow-up" aria-hidden="true"></i>
          </a>
          <p>旅程会结束，但记得一直都在。</p>
          <div class="memoir-footer-meta">
            <a class="memoir-footer-wordmark" href={getLocalizedPath('/')}>yichu</a>
            <span>© 2026 yichu</span>
            <span>记录技术、阅读、思考与生活。</span>
          </div>
        </footer>
      </main>
    </div>
  </article>
</Layout>

<script>
  function initMemoirPage() {
    const page = document.querySelector<HTMLElement>('.memoir-page')
    if (!page || page.dataset.enhanced === 'true')
      return

    page.dataset.enhanced = 'true'
    document.documentElement.classList.add('memoir-enhanced')

    const memories = [...page.querySelectorAll<HTMLElement>('[data-memory]')]

    const updateCopyOffset = (memory: HTMLElement, photoHeight: number) => {
      const configuredRatio = Number.parseFloat(memory.dataset.copyOffsetRatio ?? '')
      const ratio = Number.isFinite(configuredRatio) ? configuredRatio : 1 / 3
      memory.style.setProperty('--memoir-copy-offset', `${photoHeight * ratio}px`)
    }

    if ('ResizeObserver' in window) {
      const copyOffsetObserver = new ResizeObserver((entries) => {
        entries.forEach((entry) => {
          const photo = entry.target as HTMLElement
          const memory = photo.closest<HTMLElement>('[data-memory]')
          if (memory)
            updateCopyOffset(memory, photo.getBoundingClientRect().height)
        })
      })

      memories.forEach((memory) => {
        const photo = memory.querySelector<HTMLElement>('.memoir-photo-wrap')
        if (!photo)
          return

        updateCopyOffset(memory, photo.getBoundingClientRect().height)
        copyOffsetObserver.observe(photo)
      })

      document.addEventListener('astro:before-swap', () => copyOffsetObserver.disconnect(), { once: true })
    }

    if (!('IntersectionObserver' in window)) {
      memories.forEach(memory => memory.classList.add('is-visible'))
      return
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting)
          return

        const memory = entry.target as HTMLElement
        memory.classList.add('is-visible')
        memories.forEach(item => item.classList.toggle('is-active', item === memory))
      })
    }, {
      rootMargin: '-10% 0px -20%',
      threshold: 0.18,
    })

    memories.forEach(memory => observer.observe(memory))
  }

  document.addEventListener('astro:page-load', initMemoirPage)
  initMemoirPage()
</script>
