---
import Countdown from '@/components/Countdown.astro'
import Navbar from '@/components/Navbar.astro'
import { allLocales, heroBackgroundVideoURL } from '@/config'
import { getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'
import { getPageInfo } from '@/utils/page'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const { getLocalizedPath } = getPageInfo(Astro.url.pathname)
---

<Layout
  postTitle="翻过山，让他们听见你的故事"
  postDescription="yichu的个人博客，记录技术、阅读、思考与生活。"
>
  <section class="wandor-hero" aria-labelledby="wandor-hero-title">
    <video
      class="wandor-hero-video"
      src={heroBackgroundVideoURL}
      autoplay
      loop
      muted
      playsinline
      aria-hidden="true"
    ></video>
    <div class="wandor-hero-scrim" aria-hidden="true"></div>

    <div class="wandor-hero-content">
      <header class="wandor-hero-header">
        <a class="wandor-wordmark" href={getLocalizedPath('/')} aria-label="yichu 首页">yichu</a>
        <div class="wandor-nav-shell">
          <Navbar />
        </div>
      </header>

      <div class="wandor-hero-body">
        <div class="wandor-hero-copy">
          <h1 id="wandor-hero-title">翻过山，让他们听见你的故事</h1>
          <p>记录技术、阅读、思考与生活。时间向前，故事也在发生。</p>
        </div>

        <Countdown
          label="翻过山，让他们听见你的故事"
          target="2029-09-17T21:05:00+08:00"
          targetLabel="2029 年 9 月 17 日 21:05 · 北京时间"
          variant="glass"
          showLabel={false}
          footerText="Bravo!"
        />
      </div>
    </div>
  </section>
</Layout>
