---
import { readFile } from 'node:fs/promises'
import CinematicBackground from '@/components/CinematicBackground.astro'
import Navbar from '@/components/Navbar.astro'
import { allLocales } from '@/config'
import { getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'
import { getPageInfo } from '@/utils/page'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

interface DailyUsage {
  date: string
  inputTokens: number
  cachedInputTokens: number
  freshInputTokens: number
  outputTokens: number
  reasoningTokens: number
  totalTokens: number
}

interface TokenUsage {
  generatedAt: string
  timezone: string
  summary: {
    sessionCount: number
    activeDays: number
    inputTokens: number
    outputTokens: number
    reasoningTokens: number
    totalTokens: number
    cacheHitRate: number
  }
  daily: DailyUsage[]
}

const dataUrl = new URL('../../../public/data/token-usage.json', import.meta.url)
const tokenUsage = JSON.parse(await readFile(dataUrl, 'utf8')) as TokenUsage
const compactNumber = new Intl.NumberFormat('zh-CN', {
  notation: 'compact',
  maximumFractionDigits: 2,
})
const fullNumber = new Intl.NumberFormat('zh-CN')
const dateParts = new Intl.DateTimeFormat('zh-CN', {
  timeZone: tokenUsage.timezone,
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
}).formatToParts(new Date(tokenUsage.generatedAt))
const datePart = (type: Intl.DateTimeFormatPartTypes) => dateParts.find(part => part.type === type)?.value ?? ''
const updatedAt = `${datePart('year')}/${datePart('month')}/${datePart('day')} ${datePart('hour')}:${datePart('minute')}`
const latestDay = tokenUsage.daily.at(-1)
const latestWan = latestDay ? `${(latestDay.totalTokens / 10000).toFixed(2)}万` : '0'
const pageTitle = 'Codex Token 用量'
const pageDescription = '按日期查看本地 Codex 会话的 Token 输入、缓存与输出统计。'
const { getLocalizedPath } = getPageInfo(Astro.url.pathname)
---

<Layout postTitle={pageTitle} postDescription={pageDescription} immersive>
  <section class="usage-observatory" aria-labelledby="usage-title" data-usage-page data-usage={JSON.stringify(tokenUsage)}>
    <CinematicBackground class="usage-observatory-video" />
    <div class="usage-observatory-scrim" aria-hidden="true"></div>

    <div class="usage-observatory-content">
      <header class="wandor-hero-header usage-observatory-header">
        <a class="wandor-wordmark" href={getLocalizedPath('/')} aria-label="yichu 首页">yichu</a>
        <div class="wandor-nav-shell">
          <Navbar variant="overlay" />
        </div>
      </header>

      <main class="usage-observatory-main">
        <div class="usage-intro-row">
          <header class="usage-intro">
            <h1 id="usage-title">Token用量</h1>
            <p>一份只保留数字、不读取对话内容的本地使用记录。</p>
          </header>
          <p class="usage-update"><span>LOCAL LOGS</span> · 更新于 {updatedAt}</p>
        </div>

        <section class="usage-total" aria-label="累计 Token">
          <span>累计 Token</span>
          <strong>{compactNumber.format(tokenUsage.summary.totalTokens)}</strong>
          <p>{fullNumber.format(tokenUsage.summary.totalTokens)} tokens</p>
        </section>

        <section class="usage-chart-panel" aria-labelledby="usage-chart-title">
          <div class="usage-chart-head">
            <div>
              <h2 id="usage-chart-title">每日 Token 流量</h2>
              <div class="usage-legend" aria-label="图例">
                <span><i class="legend-fresh"></i>新输入</span>
                <span><i class="legend-cache"></i>缓存输入</span>
                <span><i class="legend-output"></i>输出</span>
              </div>
            </div>

            <div class="usage-chart-controls">
              <div class="usage-ranges" role="group" aria-label="图表时间范围">
                <button type="button" data-range="7">7天</button>
                <button type="button" data-range="30">30天</button>
                <button type="button" data-range="all" class="is-active">全部</button>
              </div>
              <p class="usage-latest-callout">
                <span>{latestDay?.date ?? '—'}</span>
                <b>·</b>
                <strong data-latest-value>{latestWan} tokens</strong>
              </p>
            </div>
          </div>

          <div class="usage-chart-scroll">
            <div class="usage-chart" data-usage-chart>
              <svg
                data-usage-svg
                viewBox="0 0 1200 270"
                role="img"
                aria-labelledby="chart-title chart-description"
                preserveAspectRatio="none"
              >
                <title id="chart-title">每日 Token 使用量柱状图</title>
                <desc id="chart-description">按日期展示新输入、缓存输入与输出 Token。</desc>
              </svg>
              <div class="usage-tooltip" data-usage-tooltip hidden></div>
            </div>
          </div>
        </section>

        <section class="usage-summary" aria-label="Token 用量概要">
          <article class="usage-stat">
            <span>输入 Token</span>
            <strong>{compactNumber.format(tokenUsage.summary.inputTokens)}</strong>
          </article>
          <article class="usage-stat">
            <span>输出 Token</span>
            <strong>{compactNumber.format(tokenUsage.summary.outputTokens)}</strong>
          </article>
          <article class="usage-stat">
            <span>推理输出</span>
            <strong>{compactNumber.format(tokenUsage.summary.reasoningTokens)}</strong>
          </article>
          <article class="usage-stat">
            <span>缓存复用率</span>
            <strong>{(tokenUsage.summary.cacheHitRate * 100).toFixed(1)}%</strong>
          </article>
          <div class="usage-activity">
            <p><strong>{tokenUsage.summary.activeDays}</strong> 个活跃日期</p>
            <p><strong>{tokenUsage.summary.sessionCount}</strong> 个本地会话</p>
          </div>
        </section>

        <footer class="usage-note">
          <span aria-hidden="true">◇</span>
          <p>仅统计本机 <code>token_count</code>，不包含提示词、回复内容或文件信息。</p>
        </footer>
      </main>
    </div>
  </section>
</Layout>

<script>
interface DailyUsage {
  date: string
  cachedInputTokens: number
  freshInputTokens: number
  outputTokens: number
  totalTokens: number
}

interface UsageData {
  daily: DailyUsage[]
}

function initUsagePage() {
  const page = document.querySelector<HTMLElement>('[data-usage-page]')
  if (!page || page.dataset.initialized === 'true')
    return

  const svg = page.querySelector<SVGSVGElement>('[data-usage-svg]')
  const tooltip = page.querySelector<HTMLElement>('[data-usage-tooltip]')
  const rangeButtons = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-range]'))
  if (!svg || !tooltip)
    return

  const chartSvg = svg
  const chartTooltip = tooltip
  const usage = JSON.parse(page.dataset.usage ?? '{"daily":[]}') as UsageData
  const latestValue = page.querySelector<HTMLElement>('[data-latest-value]')
  const latestRecord = usage.daily.at(-1)
  if (latestValue && latestRecord) {
    const roundedWan = Math.round(latestRecord.totalTokens / 100) / 100
    latestValue.textContent = `${roundedWan.toFixed(2)}万 tokens`
  }
  const full = new Intl.NumberFormat('zh-CN')
  const chartWidth = 1200
  const chartHeight = 270
  const padding = { top: 25, right: 18, bottom: 44, left: 50 }

  function render(range: string) {
    const count = range === 'all' ? usage.daily.length : Number(range)
    const records = usage.daily.slice(-count)
    const innerWidth = chartWidth - padding.left - padding.right
    const innerHeight = chartHeight - padding.top - padding.bottom
    const highest = Math.max(...records.map(item => item.totalTokens), 1)
    const scaleMax = Math.ceil(highest / 10_000_000) * 10_000_000
    const slot = innerWidth / Math.max(records.length, 1)
    const barWidth = Math.min(39, slot * 0.54)
    const latestIndex = records.length - 1

    const grid = Array.from({ length: 4 }, (_, index) => {
      const ratio = index / 3
      const y = padding.top + innerHeight * ratio
      const value = scaleMax * (1 - ratio)
      return `
        <line x1="${padding.left}" y1="${y}" x2="${chartWidth - padding.right}" y2="${y}" class="chart-grid" />
        <text x="${padding.left - 12}" y="${y + 4}" text-anchor="end" class="chart-axis">${value === 0 ? '0' : `${Math.round(value / 10000)}万`}</text>
      `
    }).join('')

    const bars = records.map((item, index) => {
      const x = padding.left + slot * index + (slot - barWidth) / 2
      const baseY = padding.top + innerHeight
      const totalHeight = Math.max((item.totalTokens / scaleMax) * innerHeight, 4)
      const outputHeight = Math.max((item.outputTokens / item.totalTokens) * totalHeight, 2)
      const freshHeight = Math.max((item.freshInputTokens / item.totalTokens) * totalHeight, 2)
      const cacheHeight = Math.max(totalHeight - outputHeight - freshHeight, 1)
      const topY = baseY - totalHeight
      const cacheY = topY + freshHeight
      const outputY = cacheY + cacheHeight
      const shortDate = item.date.slice(5)
      const roundedWan = Math.round(item.totalTokens / 100) / 100
      const label = `${roundedWan.toFixed(2).replace(/\.00$/, '')}万`
      const latestGuide = index === latestIndex
        ? `<line x1="${x + barWidth / 2}" y1="${Math.max(topY - 34, 4)}" x2="${x + barWidth / 2}" y2="${topY - 4}" class="chart-latest-guide" />`
        : ''

      return `
        <g class="chart-day" data-index="${index}" tabindex="0" role="button" aria-label="${item.date}，${full.format(item.totalTokens)} Token">
          ${latestGuide}
          <text x="${x + barWidth / 2}" y="${Math.max(topY - 9, 13)}" text-anchor="middle" class="chart-value">${label}</text>
          <rect x="${x}" y="${topY}" width="${barWidth}" height="${freshHeight}" rx="2" class="bar-fresh" />
          <rect x="${x}" y="${cacheY}" width="${barWidth}" height="${cacheHeight}" class="bar-cache" />
          <rect x="${x}" y="${outputY}" width="${barWidth}" height="${outputHeight}" class="bar-output" />
          <rect x="${x - slot * 0.22}" y="${padding.top}" width="${barWidth + slot * 0.44}" height="${innerHeight}" class="bar-hit" />
          <text x="${x + barWidth / 2}" y="${chartHeight - 14}" text-anchor="middle" class="chart-date">${shortDate}</text>
        </g>
      `
    }).join('')

    chartSvg.innerHTML = `
      <title>每日 Token 使用量柱状图</title>
      <desc>按日期展示新输入、缓存输入与输出 Token。</desc>
      ${grid}
      <line x1="${padding.left}" y1="${padding.top + innerHeight}" x2="${chartWidth - padding.right}" y2="${padding.top + innerHeight}" class="chart-baseline" />
      ${bars}
    `

    Array.from(chartSvg.querySelectorAll<SVGGElement>('[data-index]')).forEach((group) => {
      const index = Number(group.dataset.index)
      const item = records[index]
      const showTooltip = (event: Event) => {
        const pointer = event as PointerEvent
        const chartRect = chartSvg.getBoundingClientRect()
        chartTooltip.innerHTML = `
          <strong>${item.date}</strong>
          <span>总量 ${full.format(item.totalTokens)}</span>
          <span>新输入 ${full.format(item.freshInputTokens)}</span>
          <span>缓存 ${full.format(item.cachedInputTokens)}</span>
          <span>输出 ${full.format(item.outputTokens)}</span>
        `
        chartTooltip.hidden = false
        const x = 'clientX' in pointer && pointer.clientX
          ? pointer.clientX - chartRect.left
          : chartRect.width / 2
        chartTooltip.style.left = `${Math.min(Math.max(x, 88), chartRect.width - 88)}px`
      }
      group.addEventListener('pointerenter', showTooltip)
      group.addEventListener('pointermove', showTooltip)
      group.addEventListener('focus', showTooltip)
      group.addEventListener('pointerleave', () => chartTooltip.hidden = true)
      group.addEventListener('blur', () => chartTooltip.hidden = true)
    })
  }

  rangeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      rangeButtons.forEach(item => item.classList.toggle('is-active', item === button))
      render(button.dataset.range ?? 'all')
    })
  })

  page.dataset.initialized = 'true'
  render('all')
}

document.addEventListener('astro:page-load', initUsagePage)
initUsagePage()
</script>

<style>
  :global(html:has(.usage-observatory)) {
    background: #0b1d26;
    overflow-y: auto;
    scrollbar-gutter: auto;
  }

  :global(body:has(.usage-observatory)) {
    margin: 0;
    overflow-x: hidden;
    overflow-y: auto;
    background: #0b1d26;
  }

  .usage-observatory {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    overflow-x: hidden;
    overflow-y: visible;
    isolation: isolate;
    background: #0b1d26;
    color: #f1ead8;
    font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  :global(.usage-observatory-video),
  .usage-observatory-scrim {
    position: fixed;
    z-index: -3;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  :global(.usage-observatory-video) {
    object-fit: cover;
    object-position: center;
    filter: saturate(0.9) contrast(1.04) brightness(0.96);
  }

  .usage-observatory-scrim {
    z-index: -2;
    background:
      linear-gradient(180deg, rgba(3, 11, 16, 0.48) 0%, rgba(3, 10, 14, 0.19) 42%, rgba(3, 10, 14, 0.56) 100%),
      linear-gradient(90deg, rgba(3, 10, 14, 0.28) 0%, rgba(3, 10, 14, 0.06) 56%, rgba(3, 10, 14, 0.12) 100%);
  }

  .usage-observatory-content {
    position: relative;
    width: min(100% - 3rem, 85rem);
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0 auto;
  }

  .usage-observatory-header {
    position: absolute;
  }

  .usage-observatory-main {
    padding: 6.9rem 0 1.2rem;
  }

  .usage-intro-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: start;
  }

  .usage-intro h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.7rem, 2.25vw, 2.15rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .usage-intro p,
  .usage-update {
    margin: 0.65rem 0 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.84rem;
    line-height: 1.45;
    letter-spacing: 0.015em;
  }

  .usage-update {
    margin-top: 0.45rem;
    text-align: right;
    white-space: nowrap;
  }

  .usage-update span {
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .usage-total {
    margin-top: 2.55rem;
  }

  .usage-total > span {
    color: rgba(255, 255, 255, 0.84);
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  .usage-total strong {
    display: block;
    margin-top: 0.6rem;
    color: #f4ead4;
    font-size: clamp(1.65rem, 2.6vw, 2.45rem);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.07em;
    text-shadow: 0 5px 30px rgba(0, 0, 0, 0.2);
  }

  .usage-total p {
    margin: 0.85rem 0 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.025em;
  }

  .usage-chart-panel {
    --usage-bar-fresh: rgba(255, 247, 224, 0.96);
    --usage-bar-cache: rgba(190, 209, 201, 0.88);
    --usage-bar-cache-border: rgba(229, 239, 235, 0.7);
    --usage-bar-output: rgba(203, 164, 112, 0.92);

    margin-top: 3rem;
    padding: 1.7rem 1.85rem 0.85rem;
    border: 1px solid rgba(241, 234, 216, 0.56);
    border-radius: 1rem;
    background: rgba(10, 29, 38, 0.5);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .usage-chart-head {
    display: flex;
    gap: 2rem;
    align-items: start;
    justify-content: space-between;
  }

  .usage-chart-head h2 {
    margin: 0;
    color: #fff;
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .usage-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.35rem;
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.74rem;
  }

  .usage-legend span {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }

  .usage-legend i {
    display: block;
    width: 0.9rem;
    height: 0.55rem;
    border-radius: 2px;
    background: var(--usage-bar-fresh);
  }

  .usage-legend .legend-cache {
    border: 1px solid var(--usage-bar-cache-border);
    background: var(--usage-bar-cache);
  }

  .usage-legend .legend-output {
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: var(--usage-bar-output);
  }

  .usage-chart-controls {
    display: grid;
    justify-items: end;
  }

  .usage-ranges {
    display: flex;
    flex-wrap: nowrap;
    gap: 1.7rem;
  }

  .usage-ranges button {
    position: relative;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    padding: 0.15rem 0 0.65rem;
    border: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.62);
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .usage-ranges button::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    content: '';
    opacity: 0;
    transform: scaleX(0.45);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .usage-ranges button:hover,
  .usage-ranges button:focus-visible,
  .usage-ranges button.is-active {
    color: #fff;
  }

  .usage-ranges button:hover::after,
  .usage-ranges button:focus-visible::after,
  .usage-ranges button.is-active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .usage-ranges button:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.9);
    outline-offset: 0.25rem;
  }

  .usage-latest-callout {
    margin: 1.25rem 0 0;
    padding: 0.48rem 0.7rem;
    border: 1px solid rgba(241, 234, 216, 0.36);
    border-radius: 0.45rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .usage-latest-callout b {
    margin: 0 0.25rem;
    color: rgba(255, 255, 255, 0.4);
    font-weight: 400;
  }

  .usage-latest-callout strong {
    color: #f1ead8;
    font-weight: 500;
  }

  .usage-chart-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.26) transparent;
  }

  .usage-chart {
    position: relative;
    min-width: 48rem;
  }

  .usage-chart svg {
    display: block;
    width: 100%;
    height: 18.8rem;
  }

  .usage-chart :global(.chart-grid) {
    stroke: rgba(241, 234, 216, 0.16);
    stroke-dasharray: 2 3;
    stroke-width: 1;
  }

  .usage-chart :global(.chart-baseline) {
    stroke: rgba(241, 234, 216, 0.55);
    stroke-width: 1;
  }

  .usage-chart :global(.chart-axis),
  .usage-chart :global(.chart-date),
  .usage-chart :global(.chart-value) {
    fill: rgba(255, 255, 255, 0.7);
    font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .usage-chart :global(.chart-value) {
    fill: rgba(255, 255, 255, 0.9);
    font-size: 10px;
  }

  .usage-chart :global(.bar-cache) {
    fill: var(--usage-bar-cache);
    stroke: var(--usage-bar-cache-border);
    stroke-width: 1;
  }

  .usage-chart :global(.bar-fresh) {
    fill: var(--usage-bar-fresh);
  }

  .usage-chart :global(.bar-output) {
    fill: var(--usage-bar-output);
  }

  .usage-chart :global(.bar-hit) {
    fill: transparent;
    cursor: crosshair;
  }

  .usage-chart :global(.chart-day) {
    outline: none;
  }

  .usage-chart :global(.chart-day:hover .bar-cache),
  .usage-chart :global(.chart-day:focus .bar-cache) {
    fill: rgba(216, 229, 223, 0.94);
  }

  .usage-chart :global(.chart-latest-guide) {
    stroke: rgba(241, 234, 216, 0.72);
    stroke-dasharray: 2 2;
    stroke-width: 1;
  }

  .usage-tooltip {
    position: absolute;
    z-index: 4;
    top: 0.2rem;
    display: grid;
    min-width: 9.5rem;
    gap: 0.2rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid rgba(241, 234, 216, 0.5);
    border-radius: 0.5rem;
    background: rgba(4, 12, 17, 0.94);
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.66rem;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .usage-tooltip[hidden] {
    display: none;
  }

  .usage-tooltip strong {
    margin-bottom: 0.15rem;
    color: #fff;
    font-weight: 500;
  }

  .usage-summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(11rem, 0.9fr);
    margin-top: 1.65rem;
    border-bottom: 1px solid rgba(241, 234, 216, 0.18);
  }

  .usage-stat,
  .usage-activity {
    min-width: 0;
    min-height: 4.9rem;
    padding: 0.15rem 1.8rem 0.9rem;
    border-right: 1px solid rgba(241, 234, 216, 0.38);
  }

  .usage-stat:first-child {
    padding-left: 0;
  }

  .usage-stat > span {
    display: block;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.76rem;
  }

  .usage-stat strong {
    display: block;
    margin-top: 0.48rem;
    color: #f1ead8;
    font-size: clamp(1.65rem, 2.6vw, 2.45rem);
    font-variant-numeric: tabular-nums;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .usage-activity {
    display: grid;
    gap: 0.7rem;
    align-content: center;
    padding-right: 0;
    border-right: 0;
  }

  .usage-activity p {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.77rem;
  }

