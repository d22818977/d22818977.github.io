---
import GoBackIcon from '@/assets/icons/go-back.svg'
import Navbar from '@/components/Navbar.astro'
import { allLocales, heroBackgroundVideoURL } from '@/config'
import { getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'
import { getPageInfo } from '@/utils/page'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const { getLocalizedPath } = getPageInfo(Astro.url.pathname)
---

<Layout
  postTitle="产品"
  postDescription="正在做的东西。"
  immersive
>
  <section class="product-index wandor-hero" aria-labelledby="product-index-title">
    <video
      class="wandor-hero-video"
      src={heroBackgroundVideoURL}
      autoplay
      loop
      muted
      playsinline
      aria-hidden="true"
    ></video>
    <div class="wandor-hero-scrim product-index-scrim" aria-hidden="true"></div>

    <div class="wandor-hero-content product-index-content">
      <header class="wandor-hero-header product-index-header">
        <a class="wandor-wordmark" href={getLocalizedPath('/')} aria-label="yichu 首页">yichu</a>
        <div class="wandor-nav-shell">
          <Navbar variant="overlay" />
        </div>
      </header>

      <main class="product-index-main">
        <header class="product-index-intro">
          <h1 id="product-index-title">产品</h1>
          <p>正在做的东西</p>
        </header>

        <section class="product-year" aria-labelledby="product-year-2026">
          <h2 id="product-year-2026" class="product-year-label">2026</h2>
          <div class="product-year-timeline" aria-hidden="true"></div>

          <ol class="product-list">
            <li class="product-list-item">
              <a
                class="product-card"
                href={getLocalizedPath('/product/huawei-optixstar-b896-u6/')}
                aria-label="查看 Huawei OptiXstar B896-U6 产品详情"
              >
                <span class="product-card-number">01</span>

                <span class="product-card-copy">
                  <span class="product-card-title">
                    <span>Huawei OptiXstar</span>
                    <span>B896-U6</span>
                  </span>
                  <span class="product-card-description">融合 NVR 的 FTTO 产品</span>
                  <span class="product-card-link">
                    <span>查看产品</span>
                    <GoBackIcon aria-hidden="true" fill="currentColor" />
                  </span>
                </span>

                <img
                  class="product-card-image"
                  src="/images/product/huawei-optixstar-b896-u6.webp"
                  width="2357"
                  height="2054"
                  alt=""
                  loading="eager"
                  fetchpriority="high"
                />
              </a>
            </li>
          </ol>

          <span class="product-timeline-end" aria-hidden="true"></span>
        </section>
      </main>
    </div>
  </section>
</Layout>
