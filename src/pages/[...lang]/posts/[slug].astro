---
import type { CollectionEntry } from 'astro:content'
import type { Language } from '@/i18n/config'
import { getCollection, render } from 'astro:content'
import GoBackIcon from '@/assets/icons/go-back.svg'
import Comment from '@/components/Comment/Index.astro'
import Navbar from '@/components/Navbar.astro'
import TOC from '@/components/Widgets/TOC.astro'
import { allLocales, heroBackgroundVideoURL } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { getPostPath, getTagPath } from '@/i18n/path'
import Layout from '@/layouts/Layout.astro'
import { checkPostSlugDuplication } from '@/utils/content'
import { getPostDescription } from '@/utils/description'
import { getPageInfo } from '@/utils/page'

export async function getStaticPaths() {
  const posts: CollectionEntry<'posts'>[] = await getCollection('posts')

  // Check if there are duplicate post slugs
  const duplicates = await checkPostSlugDuplication(posts)
  if (duplicates.length > 0) {
    throw new Error(`Duplicate post slugs:\n${duplicates.join('\n')}`)
  }

  // >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  // Build a map of post slugs to their supported languages
  // Handles both specific language posts (e.g., 'en') and universal posts (lang: '')
  const slugToLangsMap = new Map<string, Set<Language>>()

  for (const post of posts) {
    const slug = post.data.abbrlink || post.id
    const lang = post.data.lang

    let langSet = slugToLangsMap.get(slug)
    if (!langSet) {
      langSet = new Set()
      slugToLangsMap.set(slug, langSet)
    }

    if (lang) {
      langSet.add(lang as Language)
    }
    else {
      allLocales.forEach(locale => langSet.add(locale))
    }
  }

  // Convert the map to a sorted record for the component props
  // Ensure languages are always sorted by the order defined in config
  const slugToLangs: Record<string, Language[]> = {}
  for (const [slug, langs] of slugToLangsMap) {
    slugToLangs[slug] = [...langs].sort((a, b) => allLocales.indexOf(a) - allLocales.indexOf(b))
  }
  // >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

  return allLocales.flatMap(lang => posts
    // Show drafts in dev mode only
    .filter(post => import.meta.env.DEV || !post.data.draft)
    // Match current language or universal posts
    .filter(post => post.data.lang === lang || post.data.lang === '')
    .map((post) => {
      const slug = post.data.abbrlink || post.id
      return {
        params: { lang: getLangRouteParam(lang), slug },
        props: { post, supportedLangs: slugToLangs[slug] },
      }
    }),
  )
}

interface Props {
  post: CollectionEntry<'posts'>
  supportedLangs: Language[]
}

const { post, supportedLangs } = Astro.props
const currentLang = getLangFromLocale(Astro.currentLocale)
const { getLocalizedPath } = getPageInfo(Astro.url.pathname)
const slug = post.data.abbrlink || post.id
const description = getPostDescription(post, 'meta')
const { Content, headings, remarkPluginFrontmatter } = await render(post)

const visiblePosts = (await getCollection('posts'))
  .filter(item => import.meta.env.DEV || !item.data.draft)
  .filter(item => item.data.lang === currentLang || item.data.lang === '')
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
const currentPostIndex = visiblePosts.findIndex(item => (item.data.abbrlink || item.id) === slug)
const nextPost = currentPostIndex >= 0 ? visiblePosts[currentPostIndex + 1] : undefined
const nextPostSlug = nextPost ? nextPost.data.abbrlink || nextPost.id : undefined
const primaryTag = post.data.tags?.[0]

function formatCinematicDate(date: Date) {
  return date.toISOString().split('T')[0].replaceAll('-', '.')
}
---

<Layout
  postTitle={post.data.title}
  postDescription={description}
  postSlug={post.id}
  supportedLangs={supportedLangs}
  immersive
>
  <section class="post-cinematic" aria-labelledby="post-cinematic-title">
    <video
      class="post-cinematic-video"
      src={heroBackgroundVideoURL}
      autoplay
      loop
      muted
      playsinline
      aria-hidden="true"
    ></video>
    <div class="post-cinematic-scrim" aria-hidden="true"></div>

    <div class="post-cinematic-top">
      <header class="wandor-hero-header post-cinematic-site-header">
        <a class="wandor-wordmark" href={getLocalizedPath('/')} aria-label="yichu 首页">yichu</a>
        <div class="wandor-nav-shell">
          <Navbar variant="overlay" />
        </div>
      </header>

      <header class="post-cinematic-hero">
        <a class="post-cinematic-return" href={getLocalizedPath('/posts/')}>
          <GoBackIcon aria-hidden="true" fill="currentColor" />
          <span>返回文章</span>
        </a>

        <div
          id="post-date"
          class="post-cinematic-meta"
          transition:name={`time-${slug}${currentLang ? `-${currentLang}` : ''}`}
          data-disable-theme-toggle-transition
        >
          <time datetime={post.data.published.toISOString().split('T')[0]}>
            {formatCinematicDate(post.data.published)}
          </time>
          <span aria-hidden="true">·</span>
          <span>{remarkPluginFrontmatter.minutes} min</span>
          {primaryTag && (
            <>
              <span aria-hidden="true">·</span>
              <a href={getTagPath(primaryTag, currentLang)}>{primaryTag}</a>
            </>
          )}
        </div>

        <h1 id="post-cinematic-title" class="post-cinematic-title">
          <span
            transition:name={`post-${slug}${currentLang ? `-${currentLang}` : ''}`}
            data-disable-theme-toggle-transition
          >
            {post.data.title}
          </span>
        </h1>
      </header>
    </div>

    <article class="post-paper heti font-normal font-unified" aria-labelledby="post-cinematic-title">
      <div class="post-paper-inner">
        <div class="post-reading-rail" aria-hidden="true">
          <span></span>
        </div>

        <div id="post-content" class="post-content post-paper-content">
          <Content />
          <div id="post-copyright"></div>

          <Comment />

          <nav class="post-paper-navigation" aria-label="文章翻页">
            <a class="post-paper-back" href={getLocalizedPath('/posts/')}>
              <GoBackIcon aria-hidden="true" fill="currentColor" />
              <span>返回文章列表</span>
            </a>

            {nextPost && nextPostSlug
              ? (
                  <a class="post-paper-next" href={getPostPath(nextPostSlug, currentLang)}>
                    <span class="post-paper-next-label">下一篇</span>
                    <span>{nextPost.data.title}</span>
                    <GoBackIcon aria-hidden="true" fill="currentColor" />
                  </a>
                )
              : (
                  <span class="post-paper-next post-paper-next--empty">
                    <span class="post-paper-next-label">下一篇</span>
                    <span>暂无更多文章</span>
                  </span>
                )}
          </nav>
        </div>

        {post.data.toc && headings.length > 0 && (
          <aside class="post-paper-toc" aria-label="文章目录">
            <TOC headings={headings} />
          </aside>
        )}
      </div>
    </article>
  </section>
</Layout>
