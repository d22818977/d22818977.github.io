---
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

interface Props {
  variant?: 'default' | 'overlay'
}

const { variant = 'default' } = Astro.props
const { currentLang, isHome, isPost, isAbout, isProduct, isUsage, isMemoir, getLocalizedPath } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}

const isHomeActive = isHome
const isPostActive = isPost
const isAboutActive = isAbout
const isProductActive = isProduct
const isUsageActive = isUsage
const isMemoirActive = isMemoir

function getNavItemClass(isActive: boolean) {
  return isActive
    ? 'home-nav-link home-nav-link--active'
    : 'home-nav-link'
}

const navItems = [
  {
    href: '/',
    label: currentLang === 'zh-tw' ? '首頁' : currentLang === 'zh' ? '首页' : 'Home',
    isActive: isHomeActive,
    className: getNavItemClass(isHomeActive),
  },
  {
    href: '/posts/',
    label: currentUI.posts,
    isActive: isPostActive,
    className: getNavItemClass(isPostActive),
  },
  {
    href: '/memoir/',
    label: currentLang === 'zh-tw' ? '賽博記憶' : currentLang === 'zh' ? '赛博记忆' : 'Cyber Memory',
    isActive: isMemoirActive,
    className: getNavItemClass(isMemoirActive),
  },
  {
    href: '/product/',
    label: currentLang === 'zh-tw' ? '產品' : currentLang === 'zh' ? '产品' : 'Product',
    isActive: isProductActive,
    className: getNavItemClass(isProductActive),
  },
  {
    href: '/usage/',
    label: currentLang === 'zh-tw' ? '用量' : currentLang === 'zh' ? '用量' : 'Usage',
    isActive: isUsageActive,
    className: getNavItemClass(isUsageActive),
  },
  {
    href: '/about/',
    label: currentUI.about,
    isActive: isAboutActive,
    className: getNavItemClass(isAboutActive),
  },
]
---

<nav
  aria-label="Site Navigation"
  class:list={[
    'mb-10.5 text-3.6 font-semibold leading-2.45em font-navbar',
    'lg:(uno-desktop-column text-4 bottom-[min(9.04rem+3.85vw,12.5rem)]) cjk:tracking-wide',
    !isPost || variant === 'overlay' ? 'home-navbar' : '',
    isPost && variant !== 'overlay' ? 'post-navbar' : '',
  ]}
>
  <ul>
    {navItems.map(item => (
      <li>
        <a
          href={getLocalizedPath(item.href)}
          class={item.className}
          aria-current={item.isActive ? 'page' : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
